{
  "version": 1,
  "project": "atlas-financeiro",
  "stack": {
    "backend": "Supabase (Postgres 15 + Auth + Edge Functions Deno)",
    "frontend": "React 19 + Vite + TS strict (Tailwind v4, Template Atlas Shadcn)"
  },
  "moduleMap": {
    "plugins": ".opencode/plugins",
    "rules": ".agents/rules",
    "schemas": ".agents/schemas"
  },
  "commands": {
    "suiteFull": "npm run test:gate && npm run build && npm run typecheck",
    "unit": "npm run test:run",
    "frontendBuild": "npm run build",
    "frontendTypecheck": "npm run typecheck"
  },
  "infra": {
    "composeFile": null,
    "ports": {
      "backend": null,
      "frontend": null
    }
  },
  "mcp": {
    "required": []
  },
  "protectedPaths": [
    ".opencode/plugins/**",
    ".agents/rules/**",
    ".agents/schemas/**",
    ".agents/agents/**",
    "opencode.json",
    "harness.config.json"
  ],
  "gates": {
    "picco": "enforce",
    "evidence": "enforce",
    "hitlBatch": "enforce",
    "e2eGreenfield": "warn"
  },
  "riskPaths": [
    "**/security/**",
    "**/auth/**"
  ],
  "escalateOnRisk": {
    "e2eGreenfield": "enforce",
    "evidenceScenario": "required"
  },
  "contraproveTimeoutMs": 900000,
  "evidence": {
    "path": "harness/",
    "schema": ".agents/schemas/harness-report.schema.json"
  }
}
