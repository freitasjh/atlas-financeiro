{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/cliente/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "tsc",
    "tsConfigPath": "apps/cliente/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/cliente",
  "projects": {
    "cliente": {
      "type": "application",
      "root": "apps/cliente",
      "entryFile": "main",
      "sourceRoot": "apps/cliente/src",
      "compilerOptions": {
        "tsConfigPath": "apps/cliente/tsconfig.app.json"
      }
    },
    "control-plane": {
      "type": "application",
      "root": "apps/control-plane",
      "entryFile": "main",
      "sourceRoot": "apps/control-plane/src",
      "compilerOptions": {
        "tsConfigPath": "apps/control-plane/tsconfig.app.json"
      }
    },
    "shared-contracts": {
      "type": "library",
      "root": "libs/shared-contracts",
      "entryFile": "index",
      "sourceRoot": "libs/shared-contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared-contracts/tsconfig.lib.json"
      }
    }
  }
}
