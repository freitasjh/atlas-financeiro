{
  "name": "atlas-financeiro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs $(test \"$NODE_ENV\" = production || printf %s --allow-placeholder)",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "db:reset": "case \"$SEED_ADMIN_PASSWORD\" in *[[:space:]]*) echo 'ERRO: SEED_ADMIN_PASSWORD nao pode conter espaco, tab ou newline (PGOPTIONS divide por espaco).' >&2; exit 1;; esac; PGOPTIONS=\"-c seed.admin_password=${SEED_ADMIN_PASSWORD:-}\" supabase db reset",
    "test:run": "vitest --run",
    "test:gate": "node --test .opencode/plugins/__tests__/*.spec.mjs",
    "test:edge": "node --import ./scripts/deno-test-shim.mjs --test supabase/functions/*/index_test.ts",
    "test": "vitest",
    "tokens:build": "node scripts/build-tokens.mjs",
    "verify": "bash scripts/verify.sh",
    "check:template-overrides": "node scripts/check-template-overwrite.mjs",
    "check:internal": "node scripts/check-internal.mjs",
    "validate": "node scripts/validate.mjs",
    "migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^7.0.6",
    "@radix-ui/react-dialog": "^1.3.1",
    "@storybook/react-vite": "^10.6.7",
    "@supabase/supabase-js": "^2.47.0",
    "@tabler/icons-react": "^3.51.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cn": "^0.5.2",
    "i18next": "^24.2.0",
    "lucide-react": "^0.454.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^15.2.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "storybook": "^10.6.7",
    "tailwind-merge": "^2.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "happy-dom": "^21.0.4",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  }
}
